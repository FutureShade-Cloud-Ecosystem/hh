{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "The subset of the OpenAI compatible Chat Completions request that the TanyAI adapter relies on. It follows the Chat Completions API reference page 'Create chat completion' (platform.openai.com/docs/api-reference/chat/create) and the 'Function calling' guide (platform.openai.com/docs/guides/function-calling): messages with roles system, user, assistant and tool; an assistant message's tool_calls, each with id, type 'function' and function {name, arguments as a JSON string}; a tool message's tool_call_id; tools as {type 'function', function {name, description, parameters}}; and response_format of type json_schema. A gateway or open weight host that is OpenAI compatible accepts this subset. Fields outside the subset are refused here on purpose. Cross-turn rules (a tool message must answer a tool_call id of the previous assistant message) are enforced by the strict fake server in strict_openai_test.go.",
  "type": "object",
  "required": ["model", "messages"],
  "additionalProperties": false,
  "properties": {
    "model": {"type": "string", "minLength": 1},
    "max_tokens": {"type": "integer", "minimum": 1},
    "messages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/message"}},
    "tools": {"type": "array", "items": {"$ref": "#/$defs/tool"}},
    "response_format": {"$ref": "#/$defs/response_format"}
  },
  "$defs": {
    "message": {
      "oneOf": [
        {
          "type": "object",
          "required": ["role", "content"],
          "additionalProperties": false,
          "properties": {"role": {"enum": ["system", "user"]}, "content": {"type": "string"}}
        },
        {
          "type": "object",
          "required": ["role"],
          "additionalProperties": false,
          "properties": {
            "role": {"const": "assistant"},
            "content": {"type": ["string", "null"]},
            "tool_calls": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tool_call"}}
          }
        },
        {
          "type": "object",
          "required": ["role", "tool_call_id", "content"],
          "additionalProperties": false,
          "properties": {
            "role": {"const": "tool"},
            "tool_call_id": {"type": "string", "minLength": 1},
            "content": {"type": "string"}
          }
        }
      ]
    },
    "tool_call": {
      "type": "object",
      "required": ["id", "type", "function"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"const": "function"},
        "function": {
          "type": "object",
          "required": ["name", "arguments"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
            "arguments": {"type": "string"}
          }
        }
      }
    },
    "tool": {
      "type": "object",
      "required": ["type", "function"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "function"},
        "function": {
          "type": "object",
          "required": ["name", "description", "parameters"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
            "description": {"type": "string"},
            "parameters": {"type": "object", "required": ["type"], "properties": {"type": {"const": "object"}}}
          }
        }
      }
    },
    "response_format": {
      "type": "object",
      "required": ["type", "json_schema"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "json_schema"},
        "json_schema": {
          "type": "object",
          "required": ["name", "schema"],
          "additionalProperties": false,
          "properties": {"name": {"type": "string", "minLength": 1}, "schema": {"type": "object"}, "strict": {"type": "boolean"}}
        }
      }
    }
  }
}
