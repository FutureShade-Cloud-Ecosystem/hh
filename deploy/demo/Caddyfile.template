# The demo image's Caddy configuration template (plan r7 section 5, the
# Railway shape). The entrypoint substitutes the placeholders and pipes the
# result to Caddy on standard input; Caddy's autosave of the adapted
# configuration is pointed at the container's shared-memory tmpfs, so
# nothing generated and no secret reaches the image's layers, a volume, or
# anything that outlives the container.
#
# Placeholders:
#   __GATE_PORT__  the public port Caddy listens on (the platform's PORT)
#   __UPSTREAM__   the core's loopback address and port
#   __GATE_HASH__  the shared phrase's bcrypt hash, from the runtime value
#                  the operator sets; substituted by the entrypoint at
#                  boot, never baked into the image
#
# The gate (G6): basic authentication on the pages and on the demo mint
# routes, and on nothing else. Every other api route is the core's own
# law, which is why a staff call with a valid demo bearer and no phrase
# still answers, and /healthz answers unauthenticated for the platform.
#
# The handle blocks are ordered most specific first: the demo mint routes,
# then every other api route, then the health leg, then the app prefixes,
# then everything else, which is the front door. The core answers /api/v1/*
# itself (staff routes 401 without a bearer, the public legs answer as on any
# box), and Caddy adds nothing to those; the apps are the only things Caddy
# serves from disk.
#
# The forwarded address discipline (W2's review, routed here): the demo
# mint's per-address limit must see the address the client really came
# from. Every proxy leg REPLACES X-Forwarded-For with the remote host
# Caddy itself saw, so a client-written value never survives the proxy
# (it can buy no separate limit bucket), and the chain the core reads is
# exactly one element, the proxy's own observation. Behind another host
# edge this collapses every visitor onto the edge's address by design:
# one bucket shared at the edge is the conservative failure, and a forged
# chain is never the answer.
{
	admin off
	auto_https off
}

:__GATE_PORT__

# Never indexed, gate open or shut (decision log row 981).
header X-Robots-Tag "noindex, nofollow"

handle /api/v1/demo/* {
	basic_auth {
		demo __GATE_HASH__
	}
	reverse_proxy __UPSTREAM__ {
		header_up X-Forwarded-For "{remote_host}"
	}
}

handle /api/* {
	reverse_proxy __UPSTREAM__ {
		header_up X-Forwarded-For "{remote_host}"
	}
}

handle /healthz {
	reverse_proxy __UPSTREAM__ {
		header_up X-Forwarded-For "{remote_host}"
	}
}

# The app prefixes. Each is its own handle before the catch-all, with one
# shared root and each prefix's own try_files fallback, so every SPA's history
# mode rewrite returns that app's index.html and no other's. The gate carries
# onto every page handle unchanged: one phrase opens the front door, the till,
# the public desk and the Quote Desk. A prefix whose app is absent from the
# image (the Quote Desk, until it lands) has an empty directory and answers 404.
handle /till/* {
	basic_auth {
		demo __GATE_HASH__
	}
	root * /srv/app
	try_files {path} /till/index.html
	file_server
}

handle /buying-and-stock/* {
	basic_auth {
		demo __GATE_HASH__
	}
	root * /srv/app
	try_files {path} /buying-and-stock/index.html
	file_server
}

handle /drive/* {
