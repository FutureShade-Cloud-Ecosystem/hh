}

# The server's emailed share link addresses the customer's page as
# /quote.html?t=<token>: a rewrite, not a redirect, so the token stays in the
# one request the browser made.
handle /quote.html {
	basic_auth {
		demo __GATE_HASH__
	}
	root * /srv/app
	rewrite * /q/index.html?{query}
	file_server
}

handle {
	basic_auth {
		demo __GATE_HASH__
	}
	root * /srv/app
	try_files {path} /index.html
	file_server
}
